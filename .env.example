# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Solo servidor. Se usa para invitar usuarios desde el CRM. Nunca la pongas en el navegador.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# URL pública del CRM (para el enlace del correo de invitación)
NEXT_PUBLIC_SITE_URL=https://tu-crm.vercel.app

# Mapa (opcional). Por defecto usa los mapas de OpenStreetMap, sin clave.
# Para más tráfico usa un proveedor con clave pública restringida a tu dominio, por ejemplo MapTiler:
# NEXT_PUBLIC_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=TU_CLAVE_PUBLICA
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap
